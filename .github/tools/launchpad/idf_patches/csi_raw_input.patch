+/*
+ * A RAW (Bayer) input never reaches the CSI bridge as RAW when it is converted: the ISP
+ * demosaics it and the bridge receives the ISP's output, already in the destination
+ * format. So RAW in with any other format out is an ISP conversion, not a bridge one.
+ * The ISP's only RAW output is RAW8, so it cannot convert RAW to RAW10 or RAW12.
+ */
+static bool s_is_raw_color_format(cam_ctlr_color_t color_format)
+{
+    return (color_format == CAM_CTLR_COLOR_RAW8 ||
+            color_format == CAM_CTLR_COLOR_RAW10 ||
+            color_format == CAM_CTLR_COLOR_RAW12);
+}
