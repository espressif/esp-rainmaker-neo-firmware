# sdkconfig replacement configurations for deprecated options formatted as
# CONFIG_DEPRECATED_OPTION CONFIG_NEW_OPTION

# Earlier RainMaker Neo names
CONFIG_ESP_RMAKER_FACTORY_NAMESPACE        CONFIG_ESP_RMAKER_NEO_FACTORY_NAMESPACE
CONFIG_ESP_RMAKER_FACTORY_PARTITION_NAME   CONFIG_ESP_RMAKER_NEO_FACTORY_PARTITION_NAME
CONFIG_ESP_RMAKER_MQTT_PORT_443            CONFIG_ESP_RMAKER_NEO_MQTT_PORT_443
CONFIG_ESP_RMAKER_MQTT_PORT_8883           CONFIG_ESP_RMAKER_NEO_MQTT_PORT_8883
CONFIG_RMAKER_MQTT_SKIP_CREDENTIALS_CHECK  CONFIG_ESP_RMAKER_NEO_MQTT_SKIP_CREDENTIALS_CHECK
CONFIG_RMAKER_WORK_QUEUE_TASK_PRIORITY     CONFIG_ESP_RMAKER_NEO_WORK_QUEUE_TASK_PRIORITY
CONFIG_RMAKER_WORK_QUEUE_TASK_QUEUE_SIZE   CONFIG_ESP_RMAKER_NEO_WORK_QUEUE_TASK_QUEUE_SIZE
CONFIG_RMAKER_WORK_QUEUE_TASK_STACK_SIZE   CONFIG_ESP_RMAKER_NEO_WORK_QUEUE_TASK_STACK
