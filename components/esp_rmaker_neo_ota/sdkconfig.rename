# sdkconfig replacement configurations for deprecated options formatted as
# CONFIG_DEPRECATED_OPTION CONFIG_NEW_OPTION

# Earlier RainMaker Neo names
CONFIG_RMNG_OTA_CUSTOM_JOB_SUPPORT         CONFIG_ESP_RMAKER_NEO_OTA_CUSTOM_JOB_SUPPORT
CONFIG_RMNG_OTA_DISABLE_AUTO_REBOOT        CONFIG_ESP_RMAKER_NEO_OTA_DISABLE_AUTO_REBOOT
CONFIG_RMNG_OTA_EVENT_POOL_SIZE            CONFIG_ESP_RMAKER_NEO_OTA_EVENT_POOL_SIZE
CONFIG_RMNG_OTA_FORCE_ENABLE_ROLLBACK      CONFIG_ESP_RMAKER_NEO_OTA_FORCE_ENABLE_ROLLBACK
CONFIG_RMNG_OTA_MAX_RETRIES_DIVIDE_FACTOR  CONFIG_ESP_RMAKER_NEO_OTA_MAX_RETRIES_DIVIDE_FACTOR
CONFIG_RMNG_OTA_MQTT_BLOCKS_PER_REQUEST    CONFIG_ESP_RMAKER_NEO_MQTT_OTA_NO_OF_BLOCKS
CONFIG_RMNG_OTA_MQTT_BLOCK_SIZE            CONFIG_ESP_RMAKER_NEO_MQTT_OTA_BLOCK_SIZE
CONFIG_RMNG_OTA_MQTT_DATA_TYPE_CBOR        CONFIG_ESP_RMAKER_NEO_MQTT_OTA_DATA_TYPE_CBOR
CONFIG_RMNG_OTA_MQTT_DATA_TYPE_JSON        CONFIG_ESP_RMAKER_NEO_MQTT_OTA_DATA_TYPE_JSON
CONFIG_RMNG_OTA_PROGRESS_CHECKPOINTS       CONFIG_ESP_RMAKER_NEO_OTA_PROGRESS_CHECKPOINTS
CONFIG_RMNG_OTA_REQUEST_TIMEOUT_MS         CONFIG_ESP_RMAKER_NEO_OTA_REQUEST_TIMEOUT_MS
CONFIG_RMNG_OTA_RESUME                     CONFIG_ESP_RMAKER_NEO_OTA_RESUME
CONFIG_RMNG_OTA_ROLLBACK_WAIT_PERIOD       CONFIG_ESP_RMAKER_NEO_OTA_ROLLBACK_WAIT_PERIOD
CONFIG_RMNG_OTA_SIGNATURE_VERIFY_ENABLE    CONFIG_ESP_RMAKER_NEO_OTA_SIGNATURE_VERIFY_ENABLE
CONFIG_RMNG_OTA_TIME_SUPPORT               CONFIG_ESP_RMAKER_NEO_OTA_TIME_SUPPORT
CONFIG_RMNG_OTA_TRANSPORT_MQTT             CONFIG_ESP_RMAKER_NEO_OTA_USE_MQTT

# RainMaker classic names with a 1:1 equivalent.
CONFIG_ESP_RMAKER_OTA_ROLLBACK_WAIT_PERIOD CONFIG_ESP_RMAKER_NEO_OTA_ROLLBACK_WAIT_PERIOD
CONFIG_ESP_RMAKER_OTA_DISABLE_AUTO_REBOOT  CONFIG_ESP_RMAKER_NEO_OTA_DISABLE_AUTO_REBOOT
CONFIG_ESP_RMAKER_OTA_TIME_SUPPORT         CONFIG_ESP_RMAKER_NEO_OTA_TIME_SUPPORT
CONFIG_ESP_RMAKER_OTA_USE_MQTT             CONFIG_ESP_RMAKER_NEO_OTA_USE_MQTT
CONFIG_ESP_RMAKER_MQTT_OTA_BLOCK_SIZE      CONFIG_ESP_RMAKER_NEO_MQTT_OTA_BLOCK_SIZE
CONFIG_ESP_RMAKER_MQTT_OTA_NO_OF_BLOCKS    CONFIG_ESP_RMAKER_NEO_MQTT_OTA_NO_OF_BLOCKS
