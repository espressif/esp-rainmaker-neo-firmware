menu "External I/O Configuration"
    menu "ESP-IDF"
        orsource "$IDF_PATH/examples/common_components/env_caps/$IDF_TARGET/Kconfig.env_caps"

        config OSAL_EXT_IO_ESP_UART_PORT_NUM
            int "UART port number"
            range 0 2 if IDF_TARGET_ESP32 || IDF_TARGET_ESP32S3
            range 0 1
            default 0
            help
                UART communication port number to use.
                This should typically be set to 0 to use the same UART as the console monitor.
                See UART documentation for available port numbers.

        config OSAL_EXT_IO_ESP_UART_BAUD_RATE
            int "UART communication speed"
            range 1200 4000000 if !PM_ENABLE
            range 1200 1000000 if PM_ENABLE
            default ESP_CONSOLE_UART_BAUDRATE if OSAL_EXT_IO_ESP_UART_PORT_NUM = 0
            default 115200
            help
                UART communication speed to use.

        config OSAL_EXT_IO_ESP_UART_BUFFER_SIZE
            int "UART buffer size"
            range 128 1024
            default 256
            help
                UART buffer size to use.

        config OSAL_EXT_IO_ESP_UART_RXD
            depends on OSAL_EXT_IO_ESP_UART_PORT_NUM != 0
            int "UART RXD pin number"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_IN_RANGE_MAX
            default 5
            help
                GPIO number for UART RX pin. See UART documentation for more information
                about available pin numbers for UART.

        config OSAL_EXT_IO_ESP_UART_TXD
            depends on OSAL_EXT_IO_ESP_UART_PORT_NUM != 0
            int "UART TXD pin number"
            range ENV_GPIO_RANGE_MIN ENV_GPIO_OUT_RANGE_MAX
            default 4
            help
                GPIO number for UART TX pin. See UART documentation for more information
                about available pin numbers for UART.
    endmenu

endmenu
