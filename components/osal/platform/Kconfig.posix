menu "OSAL Platform Build Options (POSIX)"

    menu "Log level (runtime)"

        # Keeps the ESP-IDF option name: osal_log_level.h reads CONFIG_LOG_MAXIMUM_LEVEL on both platforms.
        config LOG_MAXIMUM_LEVEL
            int
            range 0 5
            default 0 if OSAL_LOG_MAXIMUM_LEVEL_NONE
            default 1 if OSAL_LOG_MAXIMUM_LEVEL_ERROR
            default 2 if OSAL_LOG_MAXIMUM_LEVEL_WARN
            default 3 if OSAL_LOG_MAXIMUM_LEVEL_INFO
            default 4 if OSAL_LOG_MAXIMUM_LEVEL_DEBUG
            default 5 if OSAL_LOG_MAXIMUM_LEVEL_VERBOSE

    endmenu

    menu "Log level (selection)"

        choice OSAL_LOG_MAXIMUM_LEVEL
            bool "Maximum log level"
            default OSAL_LOG_MAXIMUM_LEVEL_INFO
            help
                Maximum log level for POSIX builds.

            config OSAL_LOG_MAXIMUM_LEVEL_NONE
                bool "None"
                help
                    Print no logs.

            config OSAL_LOG_MAXIMUM_LEVEL_ERROR
                bool "Error"
                help
                    Print at most error logs.

            config OSAL_LOG_MAXIMUM_LEVEL_WARN
                bool "Warning"
                help
                    Print at most warning logs.

            config OSAL_LOG_MAXIMUM_LEVEL_INFO
                bool "Info"
                help
                    Print at most info logs.

            config OSAL_LOG_MAXIMUM_LEVEL_DEBUG
                bool "Debug"
                help
                    Print at most debug logs.

            config OSAL_LOG_MAXIMUM_LEVEL_VERBOSE
                bool "Verbose"
                help
                    Print at most verbose logs.

        endchoice

    endmenu

endmenu

# ext-io fallbacks (POSIX-only parse; this file is never read by ESP-IDF).
# osal/Kconfig pulls in ext-io/Kconfig.ext_io on both platforms, and its UART
# entries reference ESP-IDF-provided symbols (console baudrate, GPIO env caps).
# Promptless int fallbacks keep kconfiglib from warning about undefined non-int
# references; the values are unused by the POSIX PTY implementation. The menus
# are hidden (visible if n) and exist only to group the symbols.

menu "OSAL ESP Console Fallback"
    visible if n

    config ESP_CONSOLE_UART_BAUDRATE
        int
        default 115200

endmenu

menu "OSAL GPIO Env Caps Fallback"
    visible if n

    config ENV_GPIO_RANGE_MIN
        int
        default 0

    config ENV_GPIO_IN_RANGE_MAX
        int
        default 30

    config ENV_GPIO_OUT_RANGE_MAX
        int
        default 30

endmenu
