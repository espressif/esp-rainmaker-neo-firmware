# sdkconfig replacement configurations for deprecated options formatted as
# CONFIG_DEPRECATED_OPTION CONFIG_NEW_OPTION

# Earlier RainMaker Neo names
CONFIG_HTTP_COMMON_BUFFER_SIZE                  CONFIG_OSAL_HTTP_BUFFER_SIZE
CONFIG_HTTP_COMMON_FORCE_USE_CERTIFICATE_BUNDLE CONFIG_OSAL_HTTP_FORCE_USE_CERTIFICATE_BUNDLE
CONFIG_HTTP_COMMON_TIMEOUT_MS                   CONFIG_OSAL_HTTP_TIMEOUT_MS
CONFIG_OSAL_DISCOVERY_DISCOVERY_TYPE_MDNS       CONFIG_OSAL_DISCOVERY_TYPE_MDNS
CONFIG_OSAL_DISCOVERY_DISCOVERY_TYPE_SRP        CONFIG_OSAL_DISCOVERY_TYPE_SRP
