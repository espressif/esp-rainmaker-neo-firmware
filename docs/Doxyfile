## Deliberately not documented (no EXCLUDE needed -- INPUT is an explicit
## whitelist, so anything absent above is already out):
##   components/esp_rmaker_neo_ota/deps/                  vendored coreJSON, Jobs-for-AWS-IoT,
##                                              MQTTFileDownloader
##   components/osal/                           the OS abstraction layer in full. It is an
##                                              internal porting layer, not API consumers call:
##                                              they use the esp_rmaker_neo* components. osal
##                                              types that appear in documented signatures
##                                              (osal_err_t, osal_storage_handle_t, ...) render
##                                              as plain text rather than links, which is
##                                              correct -- they are not part of the public API.
##   components/esp_rmaker_neo/include/stubs/, components/esp_rmaker_neo/lib/   internal stubs and
##                                              bundled libs (esp_schedule, mocks)
##   */priv_include/, test/cbmc/include/        private and verification-only

## Get warnings for functions that have no documentation for their parameters
## or return value
WARN_NO_PARAMDOC = YES

## Enable preprocessing so Kconfig-gated APIs appear, and so __attribute__(...)
## expressions are removed from the INPUT files
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
## ENV_DOXYGEN_DEFINES carries the Kconfig/soc defines injected by esp-docs.
## __attribute__(x)=      : Breathe feeds declarations to Sphinx' C++ parser,
##                          which rejects GCC attributes ("Expected '(' after
##                          '__attribute__'"), so strip them here.
## OSAL_EVENT_DECLARE_BASE(x)=
##                        : a file-scope macro invocation that Doxygen records as
##                          a *function* named OSAL_EVENT_DECLARE_BASE. Two
##                          headers invoke it, so the generated
##                          `.. doxygenfunction:: OSAL_EVENT_DECLARE_BASE` is
##                          ambiguous and unresolvable. Stripping it drops the
##                          extern event-base declarations from the reference;
##                          the event enums themselves are still documented.
PREDEFINED             = \
    $(ENV_DOXYGEN_DEFINES) \
    __attribute__(x)= \
    OSAL_EVENT_DECLARE_BASE(x)=

## Extract all
EXTRACT_ALL = YES

## Do not complain about not having dot
HAVE_DOT = NO

## Generate the XML that Breathe consumes; nothing else
GENERATE_XML    = YES
XML_OUTPUT      = xml

GENERATE_HTML   = NO
GENERATE_LATEX  = NO
GENERATE_MAN    = NO
GENERATE_RTF    = NO

## Skip distracting progress messages
QUIET = YES

## WARN_LOGFILE is deliberately NOT set: run_doxygen already redirects Doxygen's
## stderr into <build_dir>/doxygen-warning-log.txt, which is the file build-docs
## later diffs against doxygen-known-warnings.txt. Setting WARN_LOGFILE to the
## same name makes Doxygen open that file itself while Python holds it open for
## stderr (interleaved/truncated output); setting it to a different name hides
## the warnings from the check entirely.
