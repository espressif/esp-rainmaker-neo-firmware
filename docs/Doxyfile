# Doxygen configuration for the rm-neo-sdk C API reference.
#
# Only non-default statements are listed. Doxygen is never invoked directly:
# esp_docs.esp_extensions.run_doxygen runs it from the Sphinx build dir, so all
# generated output (xml/, xml_in/, inc/) lands under docs/sphinx/_build/... and
# nothing is written into the source tree.
#
# The INPUT block below is parsed twice:
#   1. by Doxygen itself, to produce the XML
#   2. by esp-docs (run_doxygen.get_doxyfile_input_paths), to derive the name of
#      the per-header fragment each rst page includes
# Hence the hard constraints on that block:
#   * every entry MUST be written as $(PROJECT_PATH)/<path>.h  (regex-matched)
#   * one header per line, no globs -- a glob would silently pull in the
#     vendored third-party trees listed under "Deliberately not documented"
#   * NO blank line inside the block: a blank line terminates the parse
#   * a line containing '#' is skipped by the esp-docs parser, so in-block
#     comments are fine but must never carry a header path
#
# Contract to keep: an INPUT entry `foo.h` is included by an rst page as
#   .. include-build-file:: inc/foo.inc
# Names must match. Header basenames must also be unique across the whole INPUT
# list -- Doxygen names its XML by shortest-unique-path when they collide, and
# Breathe then reports duplicate targets for the shared symbols.

PROJECT_NAME = "ESP RainMaker Neo SDK Programming Guide"

