# ESP32-C6 settings for rmaker_split_camera. Layered on top of sdkconfig.defaults.

#
# Internal RAM. On the C6, IRAM code and the heap share the same RAM, and KVS
# signaling's TLS needs the heap. The Wi-Fi IRAM options trade about 46 KB of
# heap for peak throughput, so they stay off.
#
CONFIG_ESP_WIFI_IRAM_OPT=n
CONFIG_ESP_WIFI_EXTRA_IRAM_OPT=n
CONFIG_ESP_WIFI_RX_IRAM_OPT=n
CONFIG_ESP_WIFI_SLP_IRAM_OPT=n

# Free each TLS session's copy of the server certificate after the handshake. The
# C6 holds two sessions (RainMaker MQTT and KVS signaling); this leaves about 16 KB
# more heap at idle.
CONFIG_MBEDTLS_SSL_KEEP_PEER_CERTIFICATE=n

#
# Wi-Fi init config. The P4 sends its own on every boot and deep-sleep wake, and
# the co-processor re-initialises Wi-Fi when the two differ. That drops the link
# and the signaling session. These are the values the KVS streaming_only overlays
# for a C6 pair send: static TX buffers only (the P4 allocates Wi-Fi from PSRAM),
# 10 static RX and 12 static TX. The C6 keeps these buffers in internal RAM; at
# 16 and 16 it had too little heap left to forward an offer to the P4.
#
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER=n
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=12
CONFIG_ESP_WIFI_RX_BA_WIN=16
