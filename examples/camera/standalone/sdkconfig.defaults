# Standalone camera: options for every target. Chip options are in
# sdkconfig.defaults.<target>, which IDF loads after this file. Board, sensor
# and silicon overlays go on top.

#
# Flash and partition table (8 MB, dual OTA)
#
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.8mb.csv"
CONFIG_PARTITION_TABLE_OFFSET=0xC000

CONFIG_COMPILER_OPTIMIZATION_SIZE=y

#
# PSRAM, for the media buffers and the Wi-Fi and lwIP buffers
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y
CONFIG_MDNS_TASK_CREATE_FROM_SPIRAM=y
CONFIG_MDNS_MEMORY_ALLOC_SPIRAM=y

#
# Keep code out of IRAM
#
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_ISR_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y

#
# FreeRTOS, pthread and system tasks
#
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_TIMER_TASK_STACK_DEPTH=3072
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=8000
CONFIG_PTHREAD_STACK_MIN=4096
CONFIG_ESP_IPC_TASK_STACK_SIZE=1024
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

#
# FATFS
#
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_FS_LOCK=10

#
# lwIP
#
CONFIG_LWIP_SNTP_MAX_SERVERS=3
CONFIG_LWIP_L2_TO_L3_COPY=y
CONFIG_LWIP_TCPIP_RECVMBOX_SIZE=64

#
# KVS signaling WebSocket
#
CONFIG_WS_BUFFER_SIZE=2048
CONFIG_WS_DYNAMIC_BUFFER=y

#
# RainMaker Neo: BLE provisioning with a compact QR code
#
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_APP_NETWORK_PROV_COMPACT_QR=y

# Factory partition: keep the Neo and rmaker_app_network values the same.
CONFIG_ESP_RMAKER_NEO_FACTORY_PARTITION_NAME="fctry"
CONFIG_ESP_RMAKER_NEO_FACTORY_NAMESPACE="rmaker_creds"
CONFIG_APP_NETWORK_FACTORY_NVS_PARTITION_NAME="fctry"
CONFIG_APP_NETWORK_PROV_DATA_NAMESPACE="rmaker_creds"

# Request the "kvs" capability at claim (assisted claiming only).
CONFIG_ESP_RMAKER_NEO_CLAIM_VIDEOSTREAM_SUPPORT=y
