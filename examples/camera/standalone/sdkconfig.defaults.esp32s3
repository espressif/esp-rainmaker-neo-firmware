# ESP32-S3: the ESP32-S3-EYE board, with native Wi-Fi and no co-processor.

CONFIG_ESP32S3_DEFAULT_CPU_FREQ_240=y
CONFIG_ESP32S3_DEFAULT_CPU_FREQ_MHZ=240

# Octal PSRAM. Keep internal RAM for allocations that need it.
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=0
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=16000

CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y

# The ESP32-S3-EYE console is on USB-Serial/JTAG.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# NimBLE is only used for provisioning, so the BLE 5 features are not needed.
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# Camera: the ESP32-S3-EYE OV2640 over DVP, through esp_video. The software H.264
# encoder takes YUYV as it is, so the sensor sends YUYV at QVGA.
CONFIG_BSP_SELECT_ESP32_S3_EYE=y
CONFIG_CAMERA_OV2640=y
CONFIG_CAMERA_OV2640_AUTO_DETECT_DVP_INTERFACE_SENSOR=y
CONFIG_CAMERA_OV2640_DVP_YUV422_YUYV_320x240_25FPS=y
CONFIG_CAMERA_OV2640_DVP_DEFAULT_FMT_YUV422_YUYV_320x240_25FPS=y
CONFIG_ESP_VIDEO_IF_VER_FLIP=y

# Native Wi-Fi. Without this, esp_hosted starts an SDIO host at boot on GPIO 19,
# which is the S3's USB D-, and the USB-Serial/JTAG console stops.
CONFIG_ESP_HOSTED=n
