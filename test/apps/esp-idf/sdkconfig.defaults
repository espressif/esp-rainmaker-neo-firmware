# Single ESP-IDF test app for RainMaker Neo SDK (osal, esp_rmaker_neo_common, esp_rmaker_neo,
# esp_rmaker_neo_ota). Requires those components to be present under components/.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Tests can get very large; increase the default stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable esp_rmaker_neo testing (builds test_rmaker_neo and enables test hooks)
CONFIG_ESP_RMAKER_NEO_TESTING=y
CONFIG_ESP_RMAKER_NEO_BRIDGE_ENABLE=y
# Request every claim-time cloud service, so the claim-verify test covers the
# full list ("bridge" is on by default with the bridge).
CONFIG_ESP_RMAKER_NEO_CLAIM_VIDEOSTREAM_SUPPORT=y
CONFIG_ESP_RMAKER_NEO_CLAIM_FILE_SUPPORT=y
CONFIG_ESP_RMAKER_NEO_ENABLE_PROV_LOCAL_CTRL=y

# Enable virtual scheduler (required by RainMaker Neo testing)
CONFIG_OSAL_USING_VIRTUAL_SCHEDULER=y

# test_osal_http is always built here (ESP-IDF auto-discovers it and test_app.c runs its suite), so the osal http area
# it tests must be built too. On POSIX the test dir is only added when this is on, so no equivalent is needed there.
CONFIG_OSAL_INCLUDE_HTTP=y

# Point to custom CA certificate bundle for MQTT testing
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../components/osal/mqtt/test_osal_mqtt/certs/test_osal_mqtt_ca.pem"

# Wi-Fi credentials come from Kconfig (TEST_APP_WIFI_*); Set them via menuconfig or in the sdkconfig.
# No provisioning, so no SoftAP.
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# test_rmaker_neo_common exercises the key/CSR generation helpers unconditionally, which requires this option enabled.
CONFIG_MBEDTLS_X509_CREATE_C=y

# Allow for custom job support tests.
CONFIG_ESP_RMAKER_NEO_OTA_CUSTOM_JOB_SUPPORT=y

# Disable watchdog
CONFIG_ESP_TASK_WDT_INIT=n

## Trim flash size
# Common CA roots only, not the full Mozilla bundle; the custom test CA is added on top.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Log v2 drops the per-callsite format glue.
CONFIG_LOG_VERSION_2=y
# mbedTLS error strings and self-tests are development-only.
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_SELF_TEST=n
# Nothing here terminates TLS: the protocomm HTTPS server is POSIX-only.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# P-256 and Curve25519 cover the test brokers; P-384 stays for third-party ECC roots.
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# No WPA2-Enterprise.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Factory partition: keep the Neo and rmaker_app_network values the same.
CONFIG_ESP_RMAKER_NEO_FACTORY_PARTITION_NAME="fctry"
CONFIG_ESP_RMAKER_NEO_FACTORY_NAMESPACE="rmaker_creds"
CONFIG_APP_NETWORK_FACTORY_NVS_PARTITION_NAME="fctry"
CONFIG_APP_NETWORK_PROV_DATA_NAMESPACE="rmaker_creds"

# Build the Time service Timestamp param, so its tests run
CONFIG_ESP_RMAKER_NEO_TIME_CURRENT_TIME_PARAM=y
