# Single ESP-IDF test app for RMNG SDK (osal, esp_rmaker_neo_common, esp_rmaker_neo,
# esp_rmaker_neo_ota). Requires those components to be present under components/.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Tests can get very large; increase the default stack size
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# Enable RMNG testing (builds test_rmaker_neo and enables test hooks)
CONFIG_ESP_RMAKER_NEO_TESTING=y
CONFIG_ESP_RMAKER_NEO_BRIDGE_ENABLE=y

# Enable virtual scheduler (required by RMNG testing)
CONFIG_OSAL_USING_VIRTUAL_SCHEDULER=y

# test-http-common is always built here (ESP-IDF auto-discovers it and test_app.c runs its suite), so the osal http area
# it tests must be built too. On POSIX the test dir is only added when this is on, so no equivalent is needed there.
CONFIG_OSAL_INCLUDE_HTTP=y

# Point to custom CA certificate bundle for MQTT testing
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../components/osal/mqtt/test-mqtt-common/certs/test_mqtt_common_host_crt.pem"

# Default to BLE provisioning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
# Peripheral-only, legacy advertising; Wi-Fi needs no SoftAP.
CONFIG_BT_NIMBLE_ROLE_CENTRAL=n
CONFIG_BT_NIMBLE_ROLE_OBSERVER=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n

# Support legacy provisioning apps.
CONFIG_APP_NETWORK_PROV_COMPACT_QR=n

# Disable watchdog
CONFIG_ESP_TASK_WDT_INIT=n

## Trim flash size
# Common CA roots only, not the full Mozilla bundle; the custom test CA is added on top.
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_CMN=y
# Log v2 drops the per-callsite format glue.
CONFIG_LOG_VERSION_2=y
# mbedTLS error strings and self-tests are development-only.
CONFIG_MBEDTLS_ERROR_STRINGS=n
CONFIG_MBEDTLS_SELF_TEST=n
# Nothing here terminates TLS: the protocomm HTTPS server is POSIX-only.
CONFIG_MBEDTLS_TLS_CLIENT_ONLY=y
# P-256 and Curve25519 cover the test brokers; P-384 stays for third-party ECC roots.
CONFIG_MBEDTLS_ECP_DP_SECP521R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_SECP256K1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP256R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP384R1_ENABLED=n
CONFIG_MBEDTLS_ECP_DP_BP512R1_ENABLED=n
# No WPA2-Enterprise.
CONFIG_ESP_WIFI_ENTERPRISE_SUPPORT=n

# Factory partition: keep the Neo and rmaker_app_network values the same.
CONFIG_ESP_RMAKER_NEO_FACTORY_PARTITION_NAME="fctry"
CONFIG_ESP_RMAKER_NEO_FACTORY_NAMESPACE="rmaker_creds"
CONFIG_APP_NETWORK_FACTORY_NVS_PARTITION_NAME="fctry"
CONFIG_APP_NETWORK_PROV_DATA_NAMESPACE="rmaker_creds"
