# Same style as ESP-IDF defaults; used by rmng's menuconfig when building POSIX tests.

# Force testing.
CONFIG_ESP_RMAKER_NEO_TESTING=y

# Custom CA certificate for test_osal_mqtt (POSIX CA bundle).
CONFIG_OSAL_CA_BUNDLE_CUSTOM_CERTIFICATE_BUNDLE=y
CONFIG_OSAL_CA_BUNDLE_CUSTOM_CERTIFICATE_BUNDLE_PATH="../../../components/osal/mqtt/test_osal_mqtt/certs/test_osal_mqtt_ca.pem"

# Enable osal http
CONFIG_OSAL_INCLUDE_HTTP=y

# Enable bridge testing
CONFIG_ESP_RMAKER_NEO_BRIDGE_ENABLE=y

# Request every claim-time cloud service, so the claim-verify test covers the capabilities array ("bridge" is on by
# default with the bridge).
CONFIG_ESP_RMAKER_NEO_CLAIM_VIDEOSTREAM_SUPPORT=y
CONFIG_ESP_RMAKER_NEO_CLAIM_FILE_SUPPORT=y
