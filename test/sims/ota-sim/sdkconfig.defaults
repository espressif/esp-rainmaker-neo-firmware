# Baseline config for the OTA simulator, applied to every target.
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y

# Default to BLE provisioning.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_APP_NETWORK_PROV_TRANSPORT_BLE=y
CONFIG_APP_NETWORK_PROV_COMPACT_QR=y

# MQTT downloading
CONFIG_OSAL_MQTT_IMPL_CORE=y
CONFIG_ESP_RMAKER_NEO_OTA_USE_MQTT=y
# Increase the work queue size so we can process more blocks at once.
CONFIG_ESP_RMAKER_NEO_WORK_QUEUE_TASK_QUEUE_SIZE=36
CONFIG_ESP_RMAKER_NEO_MQTT_OTA_NO_OF_BLOCKS=32
CONFIG_ESP_RMAKER_NEO_OTA_RESUME=y

# Lower the default rollback timeout, since we don't do much with it.
CONFIG_ESP_RMAKER_NEO_OTA_ROLLBACK_WAIT_PERIOD=30

# Optimize build for size for all targets.
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y

# Factory partition: keep the Neo and rmaker_app_network values the same.
CONFIG_ESP_RMAKER_NEO_FACTORY_PARTITION_NAME="fctry"
CONFIG_ESP_RMAKER_NEO_FACTORY_NAMESPACE="rmaker_creds"
CONFIG_APP_NETWORK_FACTORY_NVS_PARTITION_NAME="fctry"
CONFIG_APP_NETWORK_PROV_DATA_NAMESPACE="rmaker_creds"
